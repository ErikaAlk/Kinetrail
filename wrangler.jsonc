{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinetrail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  // nodejs_compat：fitdays-api 需要 node:crypto；global_fetch_strictly_public：CIMD 抓取不得访问内网。
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // 只走自定义域名；不开 workers.dev 与预览 URL，避免出现第二个对外源。
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kinetrail.erikaalk.click", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinetrail",
      "database_id": "a5b20e9b-2531-4753-8c00-6774dfe93206",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "30800a8f19c0417aac3121f080ba8850" }],
  // 本账户 cron 注册成功却从不投递（2026-09-14 实测），同步调度由 SyncScheduler 的 alarm 驱动；cron 保留，恢复后两边经 lease 互斥。
  "triggers": { "crons": ["*/10 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "SYNC_SCHEDULER", "class_name": "SyncScheduler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncScheduler"] }],
  // 不记录调用日志（含请求 URL/query）；应用日志只写脱敏字段。
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "PUBLIC_ORIGIN": "https://kinetrail.erikaalk.click",
    "OWNER_ID": "owner",
    "FITDAYS_HISTORY_START": "2018-01-01T00:00:00+08:00",
    "ACCESS_OIDC_ISSUER": "https://erikaalk.cloudflareaccess.com/cdn-cgi/access/sso/oidc/ce38010a547c4112ef7e39a2f7809e1609ce06ff20d929954dc6453ca4ef0610",
    "ACCESS_OIDC_AUTHORIZATION_ENDPOINT": "https://erikaalk.cloudflareaccess.com/cdn-cgi/access/sso/oidc/ce38010a547c4112ef7e39a2f7809e1609ce06ff20d929954dc6453ca4ef0610/authorization",
    "ACCESS_OIDC_TOKEN_ENDPOINT": "https://erikaalk.cloudflareaccess.com/cdn-cgi/access/sso/oidc/ce38010a547c4112ef7e39a2f7809e1609ce06ff20d929954dc6453ca4ef0610/token",
    "ACCESS_OIDC_JWKS_URL": "https://erikaalk.cloudflareaccess.com/cdn-cgi/access/sso/oidc/ce38010a547c4112ef7e39a2f7809e1609ce06ff20d929954dc6453ca4ef0610/jwks",
    "ACCESS_CLIENT_ID": "ce38010a547c4112ef7e39a2f7809e1609ce06ff20d929954dc6453ca4ef0610",
    "OWNER_OIDC_SUB": "777b3d5e-dc53-50ea-81b5-329d561ca0cc",
    // 只同步本人（FitDays 成员 Erika）；其他成员与无 suid 的记录不落库。
    "PROFILE_ALLOWLIST": "p_914ea14c79915f2f",
    // FitDays/FitDays+ 同一账号只保留最后一次登录的 token，定时同步会把手机顶下线；只在用户明确刷新时登录。
    "PERIODIC_SYNC": "off",
    // Health Connect 推送：只接受晚于旧 FitDays 最后一条测量（09:17:00）的称重，避免跨来源重复。
    "HC_ACCEPT_AFTER": "2026-09-15T09:17:00+08:00",
    // FitDays+ 只把主用户写进 HC（research/HEALTHCONNECT.md G-HC3）；推送的测量归到现有本人 profile，趋势不断档。
    "HC_PROFILE_REF": "p_914ea14c79915f2f"
  }
}
