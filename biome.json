{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!research",
      "!worker-configuration.d.ts",
      "!**/*.md",
      "!.claude/worktrees",
      "!android"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      },
      "includes": ["scripts/**"]
    }
  ]
}
